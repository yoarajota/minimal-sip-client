# PJSIP 2.17 baseline — pinned build from source with the pjsua2 Python module
# (R10: no host installs; the whole baseline lives in this image).
# The baseline side of H-001: the full incumbent stack completing the same
# scenario suite (register, call, hold/resume, teardown) that the concept
# client completes — proving "the same suite that PJSIP completes in full".
FROM python:3.11-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential python3-dev swig libssl-dev libasound2-dev \
        libsrtp2-dev libgsm1-dev libspeex-dev libv4l-dev \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG PJ_VERSION=2.17
RUN curl -fsSL -o /pjproject.tar.gz \
        "https://github.com/pjsip/pjproject/archive/refs/tags/${PJ_VERSION}.tar.gz" \
    && tar xzf /pjproject.tar.gz -C / \
    && mv /pjproject-${PJ_VERSION} /pjproject

WORKDIR /pjproject
# Minimal media: no sound/video *devices* needed (the script uses the null
# device), but the sound library must be enabled so pjsua2 can re-create the
# media stream on unhold — with --disable-sound the unhold re-INVITE emits a
# port-0 loopback offer and the PBX answers 488. -fPIC: required so the
# pjsua2 Python module (a shared object) can link against the static
# pjproject libs.
ENV CFLAGS="-fPIC" CXXFLAGS="-fPIC"
RUN ./configure --disable-video --disable-openh264 \
        --disable-ffmpeg --disable-libwebrtc \
    && make dep -j"$(nproc)" \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig

# pjsua2 Python module (the incumbent's high-level API): generated by swig
# from pjsua2.i in pjsip-apps/src/swig/python, compiled via setup.py.
RUN cd pjsip-apps/src/swig/python && make all && ls -la

FROM python:3.11-slim AS runtime
COPY --from=build /usr/local/lib /usr/local/lib
RUN ldconfig && apt-get update && apt-get install -y --no-install-recommends \
        libsrtp2-1 libgsm1 libspeex1 libv4l-0 libasound2 tcpdump \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/pjsua2-py
COPY --from=build /pjproject/pjsip-apps/src/swig/python/pjsua2.py /opt/pjsua2-py/
COPY --from=build /pjproject/pjsip-apps/src/swig/python/build/lib.linux-x86_64-cpython-311/_pjsua2*.so /opt/pjsua2-py/

ENV PYTHONPATH=/opt/pjsua2-py
WORKDIR /app
COPY baseline.py /app/baseline.py
CMD ["python", "baseline.py"]
